  <dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Preview tomorrow</string><key>action</key><string>previewNow:</string></dict>
  <dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Apply once now</string><key>action</key><string>applyNow:</string></dict>
  <dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Show / export diagnostic</string><key>action</key><string>showDiagnostic:</string></dict>
