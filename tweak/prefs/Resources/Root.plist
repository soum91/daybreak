<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><array>
  <dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Calendar-driven wake time</string><key>footerText</key><string>iOS 16.1.1 Dopamine. At the evening hour, SpringBoard computes tomorrow's wake time and attempts an Apple native Sleep override. This does not guarantee that the Sleep service accepts the write or that the Watch receives it. Check Daybreak diagnostics; maintain a backup alarm.</string></dict>
  <dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Automatic native Sleep schedule</string><key>enabled</key><true/><key>defaults</key><string>com.soum91.daybreak.tweak</string><key>key</key><string>automaticEnabled</string><key>default</key><true/><key>PostNotification</key><string>com.soum91.daybreak.preferences</string></dict>
  <dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Enable Sleep alarm (not available)</string><key>enabled</key><false/><key>defaults</key><string>com.soum91.daybreak.tweak</string><key>key</key><string>enableNextSleepAlarm</string><key>default</key><false/><key>PostNotification</key><string>com.soum91.daybreak.preferences</string></dict>
  <dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Preparation minutes (0–720)</string><key>defaults</key><string>com.soum91.daybreak.tweak</string><key>key</key><string>leadMinutes</string><key>default</key><integer>60</integer><key>keyboard</key><string>NumberPad</string><key>PostNotification</key><string>com.soum91.daybreak.preferences</string></dict>
  <dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Fallback hour (0–23)</string><key>defaults</key><string>com.soum91.daybreak.tweak</string><key>key</key><string>fallbackHour</string><key>default</key><integer>8</integer><key>keyboard</key><string>NumberPad</string><key>PostNotification</key><string>com.soum91.daybreak.preferences</string></dict>
  <dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Fallback minute (0–59)</string><key>defaults</key><string>com.soum91.daybreak.tweak</string><key>key</key><string>fallbackMinute</string><key>default</key><integer>30</integer><key>keyboard</key><string>NumberPad</string><key>PostNotification</key><string>com.soum91.daybreak.preferences</string></dict>
  <dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Evening hour (12–23)</string><key>defaults</key><string>com.soum91.daybreak.tweak</string><key>key</key><string>runHour</string><key>default</key><integer>18</integer><key>keyboard</key><string>NumberPad</string><key>PostNotification</key><string>com.soum91.daybreak.preferences</string></dict>
  <dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Choose calendar (All by default)</string><key>action</key><string>chooseCalendar:</string></dict>
