  <dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Preview tomorrow</string><key>action</key><string>previewNow:</string></dict>
  <dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>How to apply native Sleep</string><key>action</key><string>applyNow:</string></dict>
